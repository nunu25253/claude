# バックエンド Spring Boot API のベースURL（末尾スラッシュなし）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1


# OGPのog:url/og:imageなど絶対URL生成に使うサイトの公開URL(末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 登録ページのBot対策(Cloudflare Turnstile)のサイトキー。未設定の場合ウィジェットは表示されず、
# 登録フローはcaptchaToken無しで従来通り動作する(バックエンドのCAPTCHA_ENABLED=falseと対応)。
# サイトキーは公開情報のため(シークレットキーと異なりクライアントに露出して問題無い)NEXT_PUBLIC_。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 課金画面(GmoCardTokenForm)のGMO-PGショップID。未設定の場合、カード入力フォームの代わりに
# 開発/評価用の手入力トークンフォームにフォールバックする(バックエンドのPAYMENT_GATEWAY_PROVIDER
# =mockと対応)。本番投入時はGMOとの契約で発行されるショップIDを設定し、バックエンド側も
# PAYMENT_GATEWAY_PROVIDER=gmoに切り替えること。ショップIDは公開情報のためNEXT_PUBLIC_。
NEXT_PUBLIC_GMO_SHOP_ID=
