# ============================================================================
# SNS AIバズ分析プラットフォーム - 環境変数サンプル
# `cp .env.example .env` してから値を編集してください。
# docker-compose.yml はこのファイルを直接読み込みません（Composeが自動でカレント
# ディレクトリの .env を読みます）。全ての値にデフォルトがあるため、
# 何も設定しなくても `docker compose up -d --build` は動作します。
# ============================================================================

# ---- Database (PostgreSQL) ----
DB_NAME=buzz_analysis
DB_USERNAME=buzz_user
DB_PASSWORD=buzz_password
DB_PORT=5432

# ---- Cache (Redis) ----
REDIS_PORT=6379

# ---- Storage (S3互換 / ローカルはMinIO) ----
S3_ACCESS_KEY=buzz_minio_admin
S3_SECRET_KEY=buzz_minio_password
S3_BUCKET=buzz-analysis-reports
S3_REGION=ap-northeast-1
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ---- JWT認証 ----
# 本番相当で動かす場合は必ずランダムな値に変更してください。
JWT_SECRET=change-this-secret-in-production-please-0123456789abcdef
JWT_ISSUER=buzz-analysis-platform
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14
# 認証トークンはHttpOnly Cookieとして発行される。ローカル(HTTP)開発ではfalseのままでよいが、
# 本番(HTTPS)では必ずtrueにすること。
JWT_COOKIE_SECURE=false
# フロント/バックエンドをapp.example.com / api.example.comのようにサブドメインで分ける場合、
# 共通の親ドメイン(例: .example.com)を設定する。同一ホスト(ポートのみ違う)の開発環境では空でよい。
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SAME_SITE=Lax

# ---- CORS ----
# フロントエンドのオリジン。複数指定はカンマ区切り。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- 認証エンドポイントのレート制限(ブルートフォース対策) ----
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15

# ---- 投稿分析(OpenAI呼び出し)のユーザー単位・日次利用上限 ----
QUOTA_DAILY_OPENAI_CALLS=50

# ---- パスワードリセットメール ----
# ローカル開発ではdocker-compose上のMailHogが受信する(http://localhost:8025 でWeb UI確認可能、
# 実際のメールは送信されない)。本番では実SMTPサーバーの値に変更してください。
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM_ADDRESS=no-reply@buzz-analysis.local
MAIL_RESET_LINK_BASE_URL=http://localhost:3000/reset-password
MAIL_VERIFICATION_LINK_BASE_URL=http://localhost:3000/verify-email

# ---- OpenAI API (AI分析) ----
# 未設定の場合、バックエンドはルールベースのフォールバック分析結果を返します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding生成(AIマーケティングOS Phase3)。次元数を変更する場合はDBマイグレーションの
# vector(1536)列定義も合わせて変更が必要。
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 各SNS公式API認証情報 ----
# 未設定の場合、各Serviceはスタブ（モック）データにフォールバックします。
# 取得方法・各APIの制約(できること/できないこと)はREADMEの「SNS公式API連携」セクションを参照。
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
X_BEARER_TOKEN=

# ---- 定期データ取得バッチ（自動化） ----
# 追跡対象アカウント(social_accounts.tracking_enabled=true)の最新公開投稿をcronで定期取得し、
# BuzzScore・ランキング(急上昇/週間/月間)を自動更新する。デフォルトはOFF。
# 有効化しなくても POST /api/v1/sync/run で手動実行できる。
BATCH_SYNC_ENABLED=false
BATCH_SYNC_CRON=0 0 * * * *
BATCH_SYNC_POST_LIMIT=20

# ---- ポート ----
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
